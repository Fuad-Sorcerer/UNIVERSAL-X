[
  {
    "name": "Pythagorean Theorem",
    "equation": "c**2 - (a**2 + b**2)",
    "variables": ["c", "a", "b"],
    "units": {"c": "unit", "a": "unit", "b": "unit"}
  },
  {
    "name": "Arithmetic Sequence (nth Term)",
    "equation": "an - (a1 + (n - 1) * d)",
    "variables": ["an", "a1", "n", "d"],
    "units": {"an": "", "a1": "", "n": "", "d": ""}
  },
  {
    "name": "Geometric Sequence (nth Term)",
    "equation": "an - a1 * (r**(n - 1))",
    "variables": ["an", "a1", "r", "n"],
    "units": {"an": "", "a1": "", "r": "", "n": ""}
  },
  {
    "name": "Area of Circle",
    "equation": "A - 3.14159 * (r**2)",
    "variables": ["A", "r"],
    "units": {"A": "m²", "r": "m"}
  },
  {
    "name": "Volume of Sphere",
    "equation": "V - (4/3) * 3.14159 * (r**3)",
    "variables": ["V", "r"],
    "units": {"V": "m³", "r": "m"}
  },
  {
    "name": "Cylinder Volume",
    "equation": "V - 3.14159 * (r**2) * h",
    "variables": ["V", "r", "h"],
    "units": {"V": "m³", "r": "m", "h": "m"}
  },
  {
    "name": "Cone Volume",
    "equation": "V - (1/3) * 3.14159 * (r**2) * h",
    "variables": ["V", "r", "h"],
    "units": {"V": "m³", "r": "m", "h": "m"}
  },
  {
    "name": "Polygon Interior Angle Sum",
    "equation": "S - (n - 2) * 180",
    "variables": ["S", "n"],
    "units": {"S": "deg", "n": "sides"}
  },
  {
    "name": "Simple Probability",
    "equation": "P - favorable / total",
    "variables": ["P", "favorable", "total"],
    "units": {"P": "", "favorable": "", "total": ""}
  }
]